{
    "name": "homebridge-nest-accfactory",
    "displayName": "Nest Accfactory",
    "type": "module",
    "version": "0.4.5-beta.4",
    "description": "Your Nest devices. At home in Apple Home. A Homebridge plugin with HomeKit Secure Video support for cameras and doorbells.",
    "author": "n0rt0nthec4t",
    "license": "Apache-2.0",
    "homepage": "https://n0rt0nthec4t.dev/homebridge-nest-accfactory",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/n0rt0nthec4t/homebridge-nest-accfactory.git"
    },
    "bugs": {
        "url": "https://github.com/n0rt0nthec4t/homebridge-nest-accfactory/issues"
    },
    "funding": "https://github.com/n0rt0nthec4t/homebridge-nest-accfactory?sponsor=1",
    "keywords": [
        "apple-home",
        "homebridge",
        "homebridge-plugin",
        "supports-hap",
        "homekit",
        "homekit-secure-video",
        "hksv",
        "google-home",
        "nest",
        "nest-camera",
        "nest-doorbell",
        "nest-floodlight",
        "nest-thermostat",
        "nest-protect",
        "nest-yale-lock",
        "nest-temperature-sensor",
        "nest-heat-link",
        "hotwater",
        "weather",
        "home-automation"
    ],
    "main": "dist/index.js",
    "engines": {
        "node": "^22.12.0 || ^24 || ^26",
        "homebridge": "^1.11.4 || ^2.5.0"
    },
    "files": [
        "LICENSE",
        "dist/**/*",
        "config.schema.json",
        "README.md",
        "CHANGELOG.md"
    ],
    "scripts": {
        "clean": "node scripts/clean.js",
        "format": "prettier --write \"{src,test,scripts}/**/*.{js,mjs}\" \"!src/{HomeKitDevice,HomeKitHistory,fetchWrapper}/**\" && eslint --fix \"src/**/*.{js,mjs}\" \"test/**/*.js\" \"scripts/**/*.js\" --ignore-pattern \"src/{HomeKitDevice,HomeKitHistory,fetchWrapper}/**\"",
        "lint": "eslint \"src/**/*.{js,mjs}\" \"test/**/*.js\" \"scripts/**/*.js\" --max-warnings=20",
        "test": "node --test \"test/*.test.js\" \"src/HomeKitDevice/*.test.js\" \"src/HomeKitHistory/*.test.js\" \"src/fetchWrapper/*.test.js\"",
        "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-exclude=\"**/*.test.js\" --test-reporter=spec --test-reporter=./test/coverage-reporter.js --test-reporter-destination=stdout --test-reporter-destination=stdout \"test/*.test.js\" \"src/HomeKitDevice/*.test.js\" \"src/HomeKitHistory/*.test.js\" \"src/fetchWrapper/*.test.js\"",
        "check": "npm run lint && npm run test:coverage && npm run build",
        "build": "npm run clean && node scripts/build.js",
        "prepublishOnly": "npm run format && npm run lint && npm run test:coverage && npm run build"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^26.6.6",
        "@typescript-eslint/parser": "^8.72.2",
        "eslint": "^10.14.0",
        "globals": "^17.14.0",
        "homebridge": "^1.11.4 || ^2.5.0",
        "prettier": "^3.10.1",
        "prettier-eslint": "^17.1.2"
    },
    "overrides": {
        "minimatch": "11.0.1"
    },
    "dependencies": {
        "chalk": "^6.0.1",
        "protobufjs": "^8.8.1",
        "werift": "^0.27.0"
    }
}
